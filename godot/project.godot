; Shadowrend — Godot 4 mobil sürümü
config_version=5

[application]

config/name="Shadowrend"
config/version="1.0.35"
config/build=44
config/description="Mobil aksiyon RPG"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.027, 0.02, 0.043, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Store="*res://scripts/core/store.gd"
Clock="*res://scripts/core/clock.gd"
D="*res://scripts/core/data.gd"
Quality="*res://scripts/core/quality.gd"
Settings="*res://scripts/core/settings.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.027, 0.031, 0.051, 1)
lights_and_shadows/directional_shadow/size=1024
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

r3_hemi_sky={"type": "vec3", "value": Vector3(0, 0, 0)}
r3_hemi_ground={"type": "vec3", "value": Vector3(0, 0, 0)}
r3_ambient={"type": "vec3", "value": Vector3(0, 0, 0)}
r3_moon_dir={"type": "vec3", "value": Vector3(0, 1, 0)}
r3_moon_col={"type": "vec3", "value": Vector3(0, 0, 0)}
r3_rim_dir={"type": "vec3", "value": Vector3(0, 1, 0)}
r3_rim_col={"type": "vec3", "value": Vector3(0, 0, 0)}
r3_time={"type": "float", "value": 0.0}
r3_player={"type": "vec2", "value": Vector2(0, 0)}
r3_toon={"type": "float", "value": 1.0}
r3_sat={"type": "float", "value": 1.4}
r3_tint={"type": "vec3", "value": Vector3(1.02, 1.0, 0.97)}
r3_expo={"type": "float", "value": 1.28}
r3_con={"type": "float", "value": 1.12}

[importer_defaults]

wav={
"compress/mode": 2
}

texture={
"mipmaps/generate": true
}
